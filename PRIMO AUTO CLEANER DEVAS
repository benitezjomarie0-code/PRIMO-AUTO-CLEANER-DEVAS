		toggleBtn.Text = "DISABLE INSTANT/LOOP"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
	else
		statusLabel.Text = "• Running: OFF"
		statusLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
		toggleBtn.Text = "ENABLE INSTANT/LOOP"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	end
end)

local function getCleanFolder()
	local comService = Workspace:FindFirstChild("ComService") or ReplicatedStorage:FindFirstChild("ComService")
	if not comService then
		for _, desc in ipairs(Workspace:GetDescendants()) do
			if desc.Name == "ComService" then
				comService = desc
				break
			end
		end
	end
	
	if comService then
		return comService:FindFirstChild("CleanFolder")
	end
	return nil
end

-- Mabilis at direktang pag-trigger ng bawat dumi sa buong folder nang sabay-sabay o sunud-sunod nang mabilis
task.spawn(function()
	while true do
		if isRunning then
			local cleanFolder = getCleanFolder()
			if cleanFolder then
				for _, child in ipairs(cleanFolder:GetChildren()) do
					if not isRunning then break end
					local prompt = child:FindFirstChildOfClass("ProximityPrompt")
					local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
					
					if prompt and part then
						local character = player.Character
						if character and character:FindFirstChild("HumanoidRootPart") then
							character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 2, 0)
						end
						
						prompt.HoldDuration = 0
						fireproximityprompt(prompt)
					end
				end
			end
		end
		task.wait(0.02)
	end
end)
